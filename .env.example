# Copy these names to a private .env file for local development.
# Never put real credentials in this example file or commit them.
GEMINI_API_KEY=
FIREBASE_SERVICE_ACCOUNT=
STUDIO_OWNER_EMAIL=
PUBLIC_APP_URL=
BETADESK_GOOGLE_CLIENT_ID=
BETADESK_GOOGLE_CLIENT_SECRET=
BETADESK_GOOGLE_REDIRECT_URI=
BETADESK_OAUTH_TOKEN_ENCRYPTION_KEY=

# Optional SMTP delivery settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
