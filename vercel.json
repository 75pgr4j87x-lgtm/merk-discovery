{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "bun install",
  "buildCommand": "bun run build",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/betadesk/:path*",
      "destination": "/api/betadesk?__betadesk_path=:path*"
    },
    {
      "source": "/api/studio/betadesk/:path*",
      "destination": "/api/studio?__studio_path=betadesk/:path*"
    },
    {
      "source": "/studio",
      "destination": "/"
    },
    {
      "source": "/studio/:path*",
      "destination": "/"
    }
  ]
}