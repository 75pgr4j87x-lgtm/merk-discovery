{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "bun install",
  "buildCommand": "bun run build",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/customer-operations/:path*",
      "destination": "/api/customer-operations/route?__customer_operations_path=:path*"
    },
    {
      "source": "/api/betadesk/:path*",
      "destination": "/api/betadesk/route?__betadesk_path=:path*"
    },
    {
      "source": "/api/studio/betadesk/:path*",
      "destination": "/api/studio/betadesk?__studio_path=betadesk/:path*"
    },
    {
      "source": "/api/studio/invite-links/:path*",
      "destination": "/api/studio/invite-links?__studio_path=invite-links/:path*"
    },
    {
      "source": "/studio",
      "destination": "/"
    },
    {
      "source": "/studio/:path*",
      "destination": "/"
    },
    {
      "source": "/customer-operations/:path*",
      "destination": "/"
    },
    {
      "source": "/feedback/:path*",
      "destination": "/"
    }
  ]
}